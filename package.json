{
  "name": "cju-mountain-club-stories",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "tsx scripts/build-content.ts",
    "content:clean": "tsx scripts/build-content.ts --clean",
    "content:check": "tsx scripts/build-content.ts --check",
    "dev": "npm run content:build && next dev --turbopack",
    "build": "npm run content:clean && next build",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.2.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
